---
/**
 * 글 한 편. 화면은 `PostScreen`이 전부 그리고, 여기서는 문서 껍데기만 씌운다.
 */
import BaseHead from '../components/BaseHead.astro';
import PostScreen from '../components/PostScreen.astro';
import { SITE_DESCRIPTION } from '../consts';
import '../styles/stage.css';

interface Props {
	slug: string;
	title: string;
	description?: string | undefined;
}

const { slug, title, description } = Astro.props;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={title} description={description ?? SITE_DESCRIPTION} />
	</head>
	<body class="list-page">
		<PostScreen slug={slug}>
			<slot />
		</PostScreen>
	</body>
</html>
