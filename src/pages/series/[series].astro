---
/**
 * 시리즈 하나의 연재 목록. 메인의 별자리와 글 화면의 스트립이 여기로 온다
 * (`/series/{시리즈 이름}/`).
 *
 * 시리즈는 원장이 아니라 글의 frontmatter가 만든다 — 멤버가 없는 시리즈는 길도 없다.
 */
import BaseHead from '../../components/BaseHead.astro';
import SeriesScreen from '../../components/SeriesScreen.astro';
import { SITE_TITLE } from '../../consts';
import seriesData from '../../data/generated/series.json';
import '../../styles/stage.css';

export function getStaticPaths() {
	return Object.entries(seriesData.series).map(([series, members]) => ({
		params: { series },
		props: { series, count: members.length },
	}));
}

const { series, count } = Astro.props;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title={`${series} — ${SITE_TITLE}`}
			description={`${series} 연재 ${count}화. 사전에 정해진 순서대로 읽는 목록.`}
		/>
	</head>
	<body class="list-page">
		<SeriesScreen series={series} />
	</body>
</html>
