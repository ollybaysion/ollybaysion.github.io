---
/**
 * 모든 글의 목록. 메인 무대에서 `/list`를 쳐야만 온다 — 무대에는 이리 오는 링크가 없다.
 *
 * 메인 무대는 시리즈 글만 그리니, 시리즈에 없는 글은 이 화면에서만 보인다.
 */
import BaseHead from '../../components/BaseHead.astro';
import ListScreen from '../../components/ListScreen.astro';
import { SITE_TITLE } from '../../consts';
import postsData from '../../data/generated/posts.json';
import '../../styles/stage.css';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`전체 — ${SITE_TITLE}`} description={`글 ${postsData.posts.length}편.`} />
	</head>
	<body class="list-page">
		<ListScreen />
	</body>
</html>
