		fill: #ffffff;
	}

	/* 본문 — 정본의 15px / 1.9. article이 화면만큼 넓어져도 글줄은 700 기둥에 남는다. */
	.body {
		box-sizing: border-box;
		width: 700px;
		margin: 0 auto;
		padding: 8px 52px 20px 52px;
		font-family: var(--stage-sans);
