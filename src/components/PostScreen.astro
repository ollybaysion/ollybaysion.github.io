								height={glint.h.toFixed(1)}
								rx={(glint.h / 2).toFixed(1)}
								opacity="0"
							/>
						))
					}
				</g>
			</g>
		</g>

		<rect class="bleed-cover" x="0" y="0" width="700" height={tail.height} fill="url(#bvigP)"></rect>
		<rect
			class="bleed-cover"
			x="0"
			y="0"
			width="700"
			height={tail.height}
			filter="url(#grainw)"
			opacity="0.05"></rect>
		<line
			class="bleed-band"
			data-at={BAND[0]}
