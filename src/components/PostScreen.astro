			data-at={BAND[1]}
			x1={BAND[1]}
			y1="0"
			x2={BAND[1]}
			y2={tail.height}
			stroke="#ffffff"
			stroke-width="0.9"
			opacity="0.056"></line>
	</svg>

	<nav class="post-index" aria-label="이 글의 자리">
		<a href={listHref}>{post.category} 목록 ({category?.count ?? 0}편)</a>
	</nav>
</article>

{/*
  길잡이 — 목차와 관련 글. 본문 옆이 넉넉하면 둘이 기둥 양옆에 갈라 선다(목차 오른쪽,
  관련 글 왼쪽)고 스크롤을 따라 내려오고, 모자라면 오른쪽 아래 알약 하나로 접혀 누르면
  한 판에 둘 다 올라온다. 자리는 post-nav.ts가 잡는다.

  article 밖에 두는 건 zoom을 안 먹게 하려고다 — 화면에 붙어 서는 것은 화면 px로 선다.
  목차는 본문 제목에서 스크립트가 만드니, 스크립트가 없으면 통째로 숨고 관련 글은 꼬리에 그대로 있다.
*/}
<aside class="pnav" data-post-nav hidden aria-label="이 글 길잡이" style={`--post-accent: ${accent};`}>
	<div class="pnav-panel" id="pnav-panel" data-panel>
		<section class="pnav-toc" data-toc hidden>
			<div class="pnav-head">
				<span class="pnav-label">목차</span>
				<span class="pnav-pct mono" data-progress-text>0%</span>
			</div>
			<div class="pnav-track"><div class="pnav-bar" data-progress></div></div>
			<ol class="pnav-list" data-toc-list></ol>
		</section>
		<section class="pnav-rel" data-rel>
			<div class="pnav-head">
				<span class="pnav-label">관련 글</span>
				<span class="pnav-pct mono">{`${related}편`}</span>
			</div>
			<div class="pnav-track"></div>
			{neighbors.length > 0 && (
				<>
					<p class="pnav-sub">가까운 글 · 좌표 기준</p>
					<ul class="pnav-links">
						{neighbors.map((near) => (
							<li>
								<a href={`/blog/${near.slug}/`}>
									<i class="pnav-dot" style={`--c: ${near.color};`} />
									<span class="pnav-t">{near.full}</span>
									<span class="pnav-meta mono">{`${near.percent}%`}</span>
								</a>
							</li>
						))}
					</ul>
				</>
			)}
			{discoveries.length > 0 && (
				<>
					<p class="pnav-sub">다른 자리에서 닮은 글</p>
					<ul class="pnav-links">
						{discoveries.map((found) => (
							<li>
								<a href={`/blog/${found.slug}/`}>
									<i class="pnav-dot is-hollow" style={`--c: ${found.color};`} />
									<span class="pnav-t">{found.full}</span>
									<span class="pnav-meta">{found.category}</span>
								</a>
							</li>
						))}
					</ul>
				</>
			)}
			{related === 0 && <p class="pnav-sub">아직 곁에 앉은 글이 없다.</p>}
			<a class="pnav-all" href={listHref}>{`${post.category} 목록 · ${category?.count ?? 0}편 →`}</a>
		</section>
	</div>
	<button
		type="button"
		class="pnav-pill"
		data-pill
		data-related={related}
		aria-controls="pnav-panel"
