{
  "name": "blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "new": "node scripts/new-post.mjs",
    "embed": "node scripts/embed.mjs",
    "embed:check": "node scripts/embed.mjs --check",
    "coords": "node scripts/assign-coords.mjs",
    "coords:check": "node scripts/assign-coords.mjs --check",
    "derived": "node scripts/build-derived.mjs",
    "predev": "npm run embed && npm run coords && npm run derived",
    "dev": "astro dev",
    "prebuild": "npm run embed && npm run coords && npm run derived",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.9",
    "github-slugger": "^2.0.0",
    "js-yaml": "^5.4.1",
    "sharp": "^0.35.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0"
  }
}
